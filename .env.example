# Server Configuration
PORT=3000
HOST=localhost

# Reference Timezone (for deterministic relative date resolution e.g., 'last Tuesday')
TIMEZONE=Asia/Kolkata

# Local SQLite Storage Path
DATABASE_PATH=./data/minimi.db

# LLM Provider: Google Gemini
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Web Search Tool: Tavily Search (The ONE tool)
# Free 1,000 searches/mo at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
