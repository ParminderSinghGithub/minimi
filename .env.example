# Server Configuration
PORT=3000
HOST=localhost

# Timezone Configuration (for deterministic relative date resolution)
# Examples: UTC, Asia/Kolkata, America/New_York
TIMEZONE=Asia/Kolkata

# Database Path
DATABASE_PATH=./data/minimi.db

# LLM Provider Configuration
# Supported: gemini, openai, anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Alternative: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Web Search Tool Configuration (The ONE tool)
# Supported: tavily, brave, mock
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here

# Alternative: Brave Search
BRAVE_API_KEY=your_brave_api_key_here
